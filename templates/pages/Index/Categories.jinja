{#def
    region: audible_region_type,
    auto_start_download: bool,
    user: DetailedUser,
    categories: dict[str, list[Audiobook]] = {},
    lazy_load = False,
#}

{% set shelves = [('trending', 'Trending this week', 'trending'), ('fiction', 'Fiction & literature', 'fiction'), ('recent_releases', 'New releases', 'new+release'), ('science', 'Science & technology', 'science'), ('biography', 'Biography & history', 'biography'), ('business', 'Business & self-help', 'business')] %}

{% if lazy_load %}
    <div class="w-full flex flex-col items-center gap-10"
         hx-get="{{ base_url }}/hx-categories"
         hx-trigger="load"
         hx-swap="outerHTML">
        <div class="w-full max-w-7xl">
            <div class="skeleton h-7 w-56 mb-4">
            </div>
            <div class="flex gap-4 overflow-hidden">
                {% for _ in range(8) %}
                    <div class="flex-none w-36 sm:w-44">
                        <div class="skeleton aspect-square w-full rounded-xl">
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% else %}
    <div class="w-full flex flex-col items-center gap-10">
        {% for key, label, query in shelves %}
            {% if categories[key] %}
                <Shelf title={{ label }} href={{ "/search?q=" ~ query }}>
                {% for book in categories[key][:20] %}
                    <div class="flex-none w-36 sm:w-44 snap-start">
                        <BookCard book_with_requests={{ book }} auto_start_download={{ auto_start_download }} region={{ region }} user={{ user }} />
                    </div>
                {% endfor %}
                </Shelf>
            {% endif %}
        {% endfor %}
    </div>
{% endif %}
