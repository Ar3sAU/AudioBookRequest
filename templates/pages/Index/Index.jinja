{#def
    user: DetailedUser,
    auto_download: bool,
    region: audible_region_type,
    show_popular: bool, # no need to show popular if sole user with requests
    show_series: bool = False, # library has series (needs Audiobookshelf sync)
    library_count: int = 0,
    series_count: int = 0,
    open_requests: int = 0,
    hero_covers: list = [],
#}

{# rotation, position, stacking for the hero's fanned covers #}
{% set fan = [('-rotate-12', 'left-0 top-6', 'z-0'), ('-rotate-6', 'left-10 top-2', 'z-10'), ('rotate-0', 'left-20 top-0', 'z-20'), ('rotate-6', 'left-30 top-2', 'z-10'), ('rotate-12', 'left-40 top-6', 'z-0')] %}

<BaseLayout title="AudioBookRequest" user={{ user }}>
<div class="w-full flex flex-col items-center px-4 sm:px-8 pb-12 gap-10 overflow-x-hidden">
    <!-- Hero -->
    <section class="relative w-full max-w-7xl mt-4 sm:mt-6 overflow-hidden rounded-3xl bg-gradient-to-br from-primary/25 via-base-200 to-secondary/20 ring-1 ring-base-content/10">
        <div class="absolute -top-24 -right-16 w-72 h-72 rounded-full bg-primary/20 blur-3xl">
        </div>
        <div class="absolute -bottom-24 -left-10 w-72 h-72 rounded-full bg-secondary/20 blur-3xl">
        </div>
        {% if hero_covers %}
            {# fanned stack of library covers, decorative #}
            <div class="hidden md:block absolute right-10 top-1/2 -translate-y-1/2 w-72 h-60"
                 aria-hidden="true">
                {% for cover in hero_covers[:5] %}
                    {% set rot, pos, z = fan[loop.index0] %}
                    <img src="{{ cover }}"
                         alt=""
                         class="absolute {{ pos }} {{ z }} {{ rot }} w-36 h-36 object-cover rounded-xl shadow-2xl ring-1 ring-white/10" />
                {% endfor %}
            </div>
        {% endif %}
        <div class="relative px-6 py-8 sm:px-10 sm:py-12 flex flex-col gap-6 md:pr-96">
            <div>
                <p class="text-sm font-semibold uppercase tracking-widest text-primary">
                    Welcome back, {{ user.username }}
                </p>
                <h1 class="mt-1 text-3xl sm:text-5xl font-extrabold tracking-tight max-w-2xl">
                    What are we listening to next?
                </h1>
            </div>
            <form action="{{ base_url }}/search" method="get" class="w-full max-w-xl">
                <label class="input input-lg w-full rounded-full shadow-lg bg-base-100/90 backdrop-blur">
                    <icons.Search />
                    <input type="search"
                           name="q"
                           class="grow"
                           placeholder="Search titles, authors or narrators"
                           aria-label="Search audiobooks" />
                </label>
            </form>
            {% if library_count or open_requests %}
                <div class="flex flex-wrap gap-2 text-sm">
                    {% if library_count %}
                        <span class="badge badge-lg bg-base-100/70 border-base-content/10 gap-1">
                            <span class="font-bold">{{ library_count }}</span> in your library
                        </span>
                    {% endif %}
                    {% if series_count %}
                        <span class="badge badge-lg bg-base-100/70 border-base-content/10 gap-1">
                            <span class="font-bold">{{ series_count }}</span> series
                        </span>
                    {% endif %}
                    {% if open_requests %}
                        <a href="{{ base_url }}/wishlist"
                           class="badge badge-lg badge-info gap-1 hover:brightness-110">
                            <span class="font-bold">{{ open_requests }}</span> waiting
                        </a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>

    {% if show_series %}
        <Index.PopularSection title="Next in your series" user={{ user }} lazy_url="/hx-series/next" description="The next book in series you have in Audiobookshelf" region={{ region }} auto_start_download={{ auto_download }} />
        <Index.PopularSection title="Missing from your series" user={{ user }} lazy_url="/hx-series/missing" description="Earlier books you don't have yet" region={{ region }} auto_start_download={{ auto_download }} />
    {% endif %}
    <Index.PopularSection title="For you" user={{ user }} view_more="/recommendations/for-you" lazy_url="/hx-for-you" description="Based on what you've requested" empty="Request a few books and recommendations will show up here." region={{ region }} auto_start_download={{ auto_download }} />
    {% if show_popular %}
        <Index.PopularSection title="Popular here" user={{ user }} lazy_url="/hx-popular" description="Most requested on this server" empty="Nothing popular yet." region={{ region }} auto_start_download={{ auto_download }} />
    {% endif %}
    <Index.Categories lazy_load={{ True }} region={{ region }} auto_start_download={{ auto_download }} user={{ user }} />
</div>
</BaseLayout>
