{#def
    title: str,
    user: DetailedUser,
    region: audible_region_type,
    reasons: list | None = None,
    view_more: str | None = None,
    lazy_url: str | None = None,
    description: str | None = None,
    empty: str | None = None,
    auto_start_download: bool = False,
    show_reasons: bool = False,
#}

{% if lazy_url %}
    {# Placeholder with skeleton cards until the row loads. #}
    <section class="w-full max-w-7xl"
             hx-get="{{ base_url }}{{ lazy_url }}"
             hx-trigger="load"
             hx-swap="outerHTML">
        <div class="mb-3">
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight">
                {{ title }}
            </h2>
            {% if description %}
                <p class="text-sm opacity-60 line-clamp-1">
                    {{ description }}
                </p>
            {% endif %}
        </div>
        <div class="flex gap-4 overflow-hidden pb-3">
            {% for _ in range(8) %}
                <div class="flex-none w-36 sm:w-44">
                    <div class="skeleton aspect-square w-full rounded-xl">
                    </div>
                    <div class="skeleton h-3 w-4/5 mt-3">
                    </div>
                    <div class="skeleton h-3 w-1/2 mt-2">
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
{% else %}
    <Shelf title={{ title }} description={{ description }} href={{ view_more }} link_text="Discover more">
    {% if reasons %}
        {% for reason in reasons[:20] %}
            <div class="flex-none w-36 sm:w-44 snap-start"
                 title="{{ reason.reason or '' }}">
                <BookCard book_with_requests={{ reason.book }} auto_start_download={{ auto_start_download }} region={{ region }} user={{ user }} caption={{ reason.reason if show_reasons else None }} />
            </div>
        {% endfor %}
    {% elif empty %}
        <div class="w-full p-6 bg-base-200 rounded-xl text-center">
            <p class="text-sm opacity-70">
                {{ empty }}
            </p>
        </div>
    {% endif %}
    </Shelf>
{% endif %}
